# SUPABASE_URL & SUPABASE_ANON_KEY: Recommended for permanent PostgreSQL storage on Vercel
# (Can also be pasted directly inside the app Settings -> Supabase Cloud Database)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_ROLE_KEY"
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Vite client-side env vars for browser fallback
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# GEMINI_API_KEY: Optional on server (can also be entered inside the app UI)
# Used for Google Gemini live Google search grounded lead research.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional on server (can also be entered inside the app UI)
# Used for instant Groq Cloud fallback discovery if Gemini quota limit is reached.
GROQ_API_KEY=""

# APP_URL: The URL where this applet or Vercel deployment is hosted.
APP_URL="MY_APP_URL"
